{
  "name": "mnemo",
  "version": "0.1.4",
  "description": "Local-first spaced-repetition app with markdown-backed cards",
  "private": true,
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg:arm64 zip:arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "chokidar": "^3.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "flexsearch": "^0.7.43",
    "js-yaml": "^4.3.0",
    "jszip": "^3.10.1",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^1.10.0",
    "ts-fsrs": "^4.4.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "js-yaml": "$js-yaml"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "^1.45.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.24",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.4",
    "rehype-stringify": "^10.0.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.5"
  }
}
